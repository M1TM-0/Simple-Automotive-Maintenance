# Contexto de build das imagens de produção (backend/Dockerfile, contexto = raiz).
# Os padrões valem a partir da raiz: use **/ para qualquer nível.

# Segredos (nunca na imagem)
**/.env
**/.env.*
!**/.env.example
!**/.env.prod.example
deploy/secrets/
deploy/certs/
deploy/.deploy-state

# Git e ferramentas
.git/
.github/
**/.pytest_cache/
**/.ruff_cache/
**/__pycache__/
**/*.py[cod]
.pre-commit-config.yaml

# Python local
**/venv/
**/.venv/

# Gerados pelo backend e pelos testes
backend/media/
backend/staticfiles/
backend/e2e-artifacts/
backend/htmlcov/
backend/.coverage
backend/coverage.xml

# Testes não vão para a imagem de produção
backend/tests/
backend/apps/*/tests/
backend/conftest.py
backend/requirements/dev.txt

# Documentação e artefatos que não rodam
docs/
backlog/
backend/docs/
*.md
frontend/node_modules/
