# ==============================================================================
# SAM — variáveis de PRODUÇÃO (BE-091). Copie para deploy/.env.prod e preencha.
#   cp deploy/.env.prod.example deploy/.env.prod && chmod 600 deploy/.env.prod
# O arquivo .env.prod NUNCA vai para o git (.gitignore) nem para as imagens.
# Usado pelo compose (interpolação) e pelos contêineres da API/jobs/monitor.
# Valores fixos de produção (DEBUG, proxy, mesma origem…) ficam no compose.prod.yml.
# Passo a passo: backend/docs/RUNBOOK.md.
# ==============================================================================

# Domínio público (sem https://). Certificado em deploy/certs/ (SAM_TLS_DIR).
SAM_SERVER_NAME=sam.exemplo.com.br
# SAM_TLS_DIR=./certs
SAM_ENVIRONMENT=produção

# ------------------------------------------------------------------ banco
POSTGRES_DB=sam
POSTGRES_USER=sam
# Só letras e números (vai dentro de uma URL): python3 -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=

# ------------------------------------------------------------------ Django
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
SAM_TIME_ZONE=America/Sao_Paulo
LOG_LEVEL=INFO
LOG_FORMAT=json

# Gunicorn (ADR 0023): conexões = GUNICORN_WORKERS × DB_POOL_MAX (+ jobs e monitor)
# devem ficar abaixo do max_connections do PostgreSQL (100).
GUNICORN_WORKERS=4
GUNICORN_THREADS=8
DB_POOL_MAX=10

# ------------------------------------------------------------------ e-mail (redefinição de senha)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SAM <nao-responda@sam.exemplo.com.br>

# ------------------------------------------------------------------ regras do negócio
SAM_ADVERTISING_PRICE_PER_DAY=10.00
SAM_MAINTENANCE_REMINDER_PERCENT=10

# ------------------------------------------------------------------ alertas (BE-092)
# Webhook que recebe JSON {"text": …, "content": …} (Slack, Discord, Mattermost…).
SAM_ALERT_WEBHOOK_URL=
# E-mails (separados por vírgula), enviados pelo SMTP acima.
SAM_ALERT_EMAILS=
# Ping a cada ciclo do monitor para um serviço externo de "dead man's switch"
# (ex.: https://hc-ping.com/<uuid>): alerta se o servidor inteiro cair.
SAM_MONITOR_PING_URL=
# Limites (padrões): expiração parada 900 s; backup com mais de 93600 s (26 h).
# SAM_EXPIRATION_MAX_AGE=900
# SAM_BACKUP_MAX_AGE=93600
# SAM_MONITOR_ERROR_RATE=0.05
# SAM_MONITOR_LATENCY_P95_SECONDS=1.0
# Logs de acesso do Nginx (IP + horário): 6 meses (Marco Civil da Internet, art. 15).
SAM_ACCESS_LOG_RETENTION_DAYS=180

# ------------------------------------------------------------------ backup (BE-090)
# Hora local do backup diário (DP-22: diário; RPO 24 h).
BACKUP_HOUR=03
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MIN=3
# Cifra (escolha UMA). Arquivos em deploy/secrets/backup/ (montado só no serviço backup).
#   Chave pública (recomendado; a privada fica FORA do servidor):
BACKUP_GPG_RECIPIENT_FILE=/run/secrets/backup/backup.pub.asc
#   ou frase secreta (guarde uma cópia fora do servidor):
# BACKUP_PASSPHRASE_FILE=/run/secrets/backup/passphrase
# Cópia fora do servidor com rclone (config em deploy/secrets/backup/rclone.conf):
BACKUP_RCLONE_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=30

# ------------------------------------------------------------------ mapa (BE-094, ADR 0024)
# Estabelecimentos do OpenStreetMap pela Overpass API (instância pública, sem custo).
# Vazio desliga a camada (o mapa mostra só as oficinas do SAM). Outras instâncias:
# https://wiki.openstreetmap.org/wiki/Overpass_API#Public_Overpass_API_instances
SAM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# SAM_OVERPASS_TIMEOUT_SECONDS=12
# SAM_OVERPASS_CACHE_SECONDS=86400
# SAM_OVERPASS_MAX_REQUESTS_PER_MINUTE=10
# THROTTLE_EXTERNAL_MAP=60/min
