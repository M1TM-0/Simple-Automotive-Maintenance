
# ==========================================
# DJANGO
# ==========================================

SECRET_KEY=COLOQUE_SUA_CHAVE_SECRETA_AQUI
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api

# ==========================================
# DATABASE
# ==========================================

# Usada ao rodar o Django fora do Docker (ajuste host/usuário/senha ao seu Postgres).
# No Docker Compose esta variável é SOBRESCRITA pelo docker-compose.yaml, que monta a
# URL a partir de POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB do .env da raiz.
DATABASE_URL=postgres://sam:sam_dev_password@db:5432/sam

# Pool de conexões (psycopg_pool)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_TIMEOUT=10

# ==========================================
# CORS / CSRF
# ==========================================

CORS_ALLOWED_ORIGINS=http://localhost:5500
CSRF_TRUSTED_ORIGINS=http://localhost:5500

# ==========================================
# MEDIA
# ==========================================

MEDIA_ROOT=media
MEDIA_URL=/media/

# ==========================================
# EMAIL
# ==========================================

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=

# ==========================================
# APPLICATION
# ==========================================

SAM_TIME_ZONE=America/Sao_Paulo
SESSION_COOKIE_AGE=1209600

# Base dos links enviados por e-mail (redefinição de senha → <base>/forgot-password.html?token=)
FRONTEND_BASE_URL=http://localhost:5500

# Caminho do init.sql. Vazio = ../database/init.sql (no Docker: /database/init.sql)
SAM_INIT_SQL_PATH=

# Imagens enviadas
SAM_IMAGE_MAX_BYTES=5242880
SAM_IMAGE_MAX_DIMENSION=4096

# Tamanho máximo do corpo (BE-086): acima disto a API responde 413.
# JSON/formulário sem arquivo (1 MB) e multipart (padrão: 3 × SAM_IMAGE_MAX_BYTES + 1 MB).
# SAM_MAX_BODY_BYTES=1048576
# SAM_MAX_UPLOAD_BYTES=16777216

# Divulgação paga de promoções (DP-09): preço = número de diárias × este valor (R$)
SAM_ADVERTISING_PRICE_PER_DAY=10.00

# Lembrete de manutenção preventiva (BE-077): avisa quando faltar no máximo este
# percentual do intervalo em km (10 → intervalo de 10.000 km avisa a 1.000 km da troca)
SAM_MAINTENANCE_REMINDER_PERCENT=10

# ==========================================
# LIMITES DE TAXA E FORÇA BRUTA (BE-033)
# ==========================================

# Formato do DRF: <n>/<sec|min|hour|day>. Excedido → 429 com Retry-After.
THROTTLE_LOGIN=5/min
THROTTLE_REGISTER=10/min
THROTTLE_RESET=5/min
# Envio de mensagens no chat (por usuário) e leituras periódicas (polling, por usuário)
THROTTLE_MESSAGE=30/min
THROTTLE_POLLING=120/min
# Estabelecimentos do OpenStreetMap no mapa (por IP; BE-094)
THROTTLE_EXTERNAL_MAP=60/min

# Bloqueio progressivo do login: THRESHOLD falhas do mesmo IP+conta (ou
# ACCOUNT_THRESHOLD falhas da conta, de qualquer IP) bloqueiam por BASE_SECONDS;
# cada nova falha dobra o bloqueio até MAX_SECONDS. Um login correto zera.
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_ACCOUNT_THRESHOLD=20
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=900
LOGIN_LOCKOUT_WINDOW_SECONDS=3600

# Cache dos contadores. Dev: memória local (padrão). Produção: precisa ser
# compartilhado entre processos — o padrão de config.settings.prod é
# django.core.cache.backends.db.DatabaseCache (rode `manage.py createcachetable`);
# LocMemCache/DummyCache são recusados em produção.
# CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
# CACHE_LOCATION=sam-local

# ==========================================
# LOGS
# ==========================================

LOG_LEVEL=INFO
# json | plain
LOG_FORMAT=json

# ==========================================
# PRODUÇÃO (config.settings.prod)
# ==========================================
# SECRET_KEY precisa ter 50+ caracteres e não pode ser o texto de exemplo.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
# ALLOWED_HOSTS é obrigatório e sem curinga (ex.: sam.exemplo.com.br).
# Os padrões abaixo passam em `manage.py check --deploy` sem avisos (BE-085);
# decisões em backend/docs/seguranca/producao.md.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Preload é difícil de desfazer: ligue só com o domínio pronto.
# SECURE_HSTS_PRELOAD=False
# Ative só atrás de proxy reverso que define X-Forwarded-Proto (Nginx, BE-089):
# USE_X_FORWARDED_PROTO=False
# E-mail de redefinição fora da requisição (tempo igual exista ou não o e-mail):
# SAM_EMAIL_ASYNC=True

# ==========================================
# MAPA: ESTABELECIMENTOS DO OPENSTREETMAP (BE-094, ADR 0010)
# ==========================================
# Overpass API pública (sem custo). Vazio desliga: o mapa mostra só as oficinas do SAM.
# Outras instâncias: https://wiki.openstreetmap.org/wiki/Overpass_API#Public_Overpass_API_instances
# SAM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# SAM_OVERPASS_TIMEOUT_SECONDS=12
# SAM_OVERPASS_CACHE_SECONDS=86400
# SAM_OVERPASS_MAX_CELLS=16
# SAM_OVERPASS_MAX_REQUESTS_PER_MINUTE=10
# SAM_OVERPASS_BACKOFF_SECONDS=60
# SAM_OVERPASS_MAX_BACKOFF_SECONDS=900
